# Copy to .env and fill in. Never commit real values.
# These are client-side (Vite) values and are safe to expose ONLY because
# Row Level Security is enabled on every table in the database.
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_URL=https://your-project.supabase.co

# Server-side only (set in backend secrets, never in this file / never VITE_ prefixed):
# LOVABLE_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
